# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Supabase ─────────────────────────────────────────────────────────────────
# supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Groq AI ──────────────────────────────────────────────────────────────────
# console.groq.com → API Keys (free tier available)
GROQ_API_KEY=your-groq-api-key

# ─── OpenWeatherMap ───────────────────────────────────────────────────────────
# openweathermap.org/api → free tier works (1000 calls/day)
OPENWEATHER_API_KEY=your-openweather-api-key

# ─── data.gov.in ──────────────────────────────────────────────────────────────
# data.gov.in → register → API key from your profile (free)
DATA_GOV_API_KEY=your-data-gov-api-key
